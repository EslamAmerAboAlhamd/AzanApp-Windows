<Window x:Class="AzanApp.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="إعدادات المؤذن" Height="640" Width="420"
        Icon="app.ico"
        FontFamily="pack://application:,,,/Fonts/#Cairo"
        WindowStartupLocation="CenterOwner" Background="#181825"
        ResizeMode="NoResize" FlowDirection="RightToLeft">
    <Grid Margin="20">
        <StackPanel>
            <TextBlock Text="⚙️ إعدادات التطبيق" Foreground="#CDD6F4" FontSize="22" FontWeight="Bold" Margin="0,0,0,20" HorizontalAlignment="Center"/>

            <CheckBox x:Name="ChkAuto" Content="تحديد الموقع تلقائياً حسب الجهاز"
                      Foreground="#CDD6F4" FontSize="14" Margin="0,0,0,10" Click="ChkAuto_Click"/>

            <TextBlock Text="الدولة / المدينة (يدوي):" Foreground="#A6ADC8" FontSize="14" Margin="0,5,0,2"/>
            <ComboBox x:Name="CmbLocation" Height="35" FontSize="14" Padding="5">
                <ComboBoxItem Content="مكة المكرمة (السعودية)"/>
                <ComboBoxItem Content="القاهرة (مصر)"/>
                <ComboBoxItem Content="القدس (فلسطين)"/>
                <ComboBoxItem Content="دبي (الإمارات)"/>
                <ComboBoxItem Content="عمان (الأردن)"/>
            </ComboBox>

            <TextBlock Text="طريقة حساب المواقيت:" Foreground="#A6ADC8" FontSize="14" Margin="0,15,0,2"/>
            <ComboBox x:Name="CmbMethod" Height="35" FontSize="14" Padding="5">
                <ComboBoxItem Content="رابطة العالم الإسلامي"/>
                <ComboBoxItem Content="أم القرى (مكة)"/>
                <ComboBoxItem Content="الهيئة المصرية العامة للمساحة"/>
                <ComboBoxItem Content="جامعة العلوم الإسلامية بكراتشي"/>
                <ComboBoxItem Content="الجمعية الإسلامية لشمال أمريكا (ISNA)"/>
            </ComboBox>

            <TextBlock Text="تعديل الساعة (اتركه 0 إذا كانت ساعة الجهاز مضبوطة):" Foreground="#A6ADC8" FontSize="14" Margin="0,15,0,2" TextWrapping="Wrap"/>
            <ComboBox x:Name="CmbDst" Height="35" FontSize="14" Padding="5">
                <ComboBoxItem Content="بدون تعديل (0)"/>
                <ComboBoxItem Content="إضافة ساعة (+1)"/>
                <ComboBoxItem Content="خصم ساعة (-1)"/>
            </ComboBox>

            <CheckBox x:Name="ChkStartup" Content="تشغيل المؤذن تلقائياً مع بدء ويندوز"
                      Foreground="#CDD6F4" FontSize="14" Margin="0,20,0,0"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,30,0,0">
                <Button Content="حفظ الإعدادات" Width="130" Height="40" Click="BtnSave_Click" Background="#89B4FA" Foreground="#11111B" FontWeight="Bold" Margin="5,0"/>
                <Button Content="إلغاء" Width="100" Height="40" Click="BtnCancel_Click" Background="#45475A" Foreground="White" Margin="5,0"/>
            </StackPanel>

            <TextBlock HorizontalAlignment="Center" Margin="0,25,0,0" FontSize="13">
                <Run Text="للتواصل أو الإبلاغ عن مشكلة: " Foreground="#A6ADC8"/>
                <Hyperlink NavigateUri="mailto:eslamae420@gmail.com?subject=المؤذن - إبلاغ عن مشكلة"
                           RequestNavigate="Email_RequestNavigate"
                           Foreground="#89B4FA">eslamae420@gmail.com</Hyperlink>
            </TextBlock>
        </StackPanel>
    </Grid>
</Window>