<Window x:Class="AzanApp.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="إعدادات المؤذن" Height="780" Width="460"
        Icon="app.ico"
        FontFamily="pack://application:,,,/Fonts/#Cairo"
        WindowStartupLocation="CenterOwner" Background="#181825"
        ResizeMode="NoResize" FlowDirection="RightToLeft">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20">
            <TextBlock Text="⚙️ إعدادات التطبيق" Foreground="#CDD6F4" FontSize="22" FontWeight="Bold" Margin="0,0,0,20" HorizontalAlignment="Center"/>

            <CheckBox x:Name="ChkAuto" Content="تحديد الموقع تلقائياً حسب الجهاز"
                      Foreground="#CDD6F4" FontSize="14" Margin="0,0,0,5" Click="ChkAuto_Click"/>
            <TextBlock x:Name="TxtCoords" Foreground="#7F849C" FontSize="12" Margin="0,0,0,5"/>

            <TextBlock Text="الدولة / المدينة (يدوي):" Foreground="#A6ADC8" FontSize="14" Margin="0,5,0,2"/>
            <ComboBox x:Name="CmbLocation" Height="35" FontSize="14" Padding="5">
                <ComboBoxItem Content="مكة المكرمة (السعودية)"/>
                <ComboBoxItem Content="القاهرة (مصر)"/>
                <ComboBoxItem Content="القدس (فلسطين)"/>
                <ComboBoxItem Content="دبي (الإمارات)"/>
                <ComboBoxItem Content="عمان (الأردن)"/>
                <ComboBoxItem Content="الإسكندرية (مصر)"/>
                <ComboBoxItem Content="المنيا (مصر)"/>
                <ComboBoxItem Content="أسيوط (مصر)"/>
                <ComboBoxItem Content="الأقصر (مصر)"/>
                <ComboBoxItem Content="أسوان (مصر)"/>
                <ComboBoxItem Content="المنصورة (مصر)"/>
                <ComboBoxItem Content="طنطا (مصر)"/>
            </ComboBox>

            <TextBlock Text="طريقة حساب المواقيت:" Foreground="#A6ADC8" FontSize="14" Margin="0,15,0,2"/>
            <ComboBox x:Name="CmbMethod" Height="35" FontSize="14" Padding="5">
                <ComboBoxItem Content="رابطة العالم الإسلامي"/>
                <ComboBoxItem Content="أم القرى (مكة)"/>
                <ComboBoxItem Content="الهيئة المصرية العامة للمساحة"/>
                <ComboBoxItem Content="جامعة العلوم الإسلامية بكراتشي"/>
                <ComboBoxItem Content="الجمعية الإسلامية لشمال أمريكا (ISNA)"/>
            </ComboBox>

            <!-- اختيار المؤذن -->
            <TextBlock Text="المؤذن:" Foreground="#A6ADC8" FontSize="14" Margin="0,15,0,2"/>
            <ComboBox x:Name="CmbMuadhin" Height="35" FontSize="14" Padding="5"/>
            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <Button Content="▶ تجربة الصوت" Width="120" Height="32" Click="BtnPreview_Click"
                        Background="#A6E3A1" Foreground="#11111B" BorderThickness="0" Margin="0,0,8,0"/>
                <Button Content="⏹ إيقاف" Width="90" Height="32" Click="BtnStopPreview_Click"
                        Background="#45475A" Foreground="White" BorderThickness="0"/>
            </StackPanel>
            <TextBlock x:Name="TxtSoundStatus" FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap"/>

            <TextBlock Text="ضبط الدقائق لكل صلاة (+ تأخير / - تقديم):" Foreground="#A6ADC8" FontSize="14" Margin="0,15,0,2"/>
            <UniformGrid Columns="6">
                <StackPanel Margin="2">
                    <TextBlock Text="الفجر" Foreground="#CDD6F4" FontSize="12" HorizontalAlignment="Center"/>
                    <TextBox x:Name="TxtAdjFajr" Text="0" FlowDirection="LeftToRight" HorizontalContentAlignment="Center" Height="30" FontSize="14"/>
                </StackPanel>
                <StackPanel Margin="2">
                    <TextBlock Text="الشروق" Foreground="#CDD6F4" FontSize="12" HorizontalAlignment="Center"/>
                    <TextBox x:Name="TxtAdjSunrise" Text="0" FlowDirection="LeftToRight" HorizontalContentAlignment="Center" Height="30" FontSize="14"/>
                </StackPanel>
                <StackPanel Margin="2">
                    <TextBlock Text="الظهر" Foreground="#CDD6F4" FontSize="12" HorizontalAlignment="Center"/>
                    <TextBox x:Name="TxtAdjDhuhr" Text="0" FlowDirection="LeftToRight" HorizontalContentAlignment="Center" Height="30" FontSize="14"/>
                </StackPanel>
                <StackPanel Margin="2">
                    <TextBlock Text="العصر" Foreground="#CDD6F4" FontSize="12" HorizontalAlignment="Center"/>
                    <TextBox x:Name="TxtAdjAsr" Text="0" FlowDirection="LeftToRight" HorizontalContentAlignment="Center" Height="30" FontSize="14"/>
                </StackPanel>
                <StackPanel Margin="2">
                    <TextBlock Text="المغرب" Foreground="#CDD6F4" FontSize="12" HorizontalAlignment="Center"/>
                    <TextBox x:Name="TxtAdjMaghrib" Text="0" FlowDirection="LeftToRight" HorizontalContentAlignment="Center" Height="30" FontSize="14"/>
                </StackPanel>
                <StackPanel Margin="2">
                    <TextBlock Text="العشاء" Foreground="#CDD6F4" FontSize="12" HorizontalAlignment="Center"/>
                    <TextBox x:Name="TxtAdjIsha" Text="0" FlowDirection="LeftToRight" HorizontalContentAlignment="Center" Height="30" FontSize="14"/>
                </StackPanel>
            </UniformGrid>

            <TextBlock Text="تعديل الساعة (اتركه 0 إذا كانت ساعة الجهاز مضبوطة):" Foreground="#A6ADC8" FontSize="14" Margin="0,15,0,2" TextWrapping="Wrap"/>
            <ComboBox x:Name="CmbDst" Height="35" FontSize="14" Padding="5">
                <ComboBoxItem Content="بدون تعديل (0)"/>
                <ComboBoxItem Content="إضافة ساعة (+1)"/>
                <ComboBoxItem Content="خصم ساعة (-1)"/>
            </ComboBox>

            <CheckBox x:Name="ChkStartup" Content="تشغيل المؤذن تلقائياً مع بدء ويندوز"
                      Foreground="#CDD6F4" FontSize="14" Margin="0,20,0,0"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,25,0,0">
                <Button Content="حفظ الإعدادات" Width="130" Height="40" Click="BtnSave_Click" Background="#89B4FA" Foreground="#11111B" FontWeight="Bold" Margin="5,0"/>
                <Button Content="إلغاء" Width="100" Height="40" Click="BtnCancel_Click" Background="#45475A" Foreground="White" Margin="5,0"/>
            </StackPanel>

            <TextBlock HorizontalAlignment="Center" Margin="0,20,0,0" FontSize="13">
                <Run Text="للتواصل أو الإبلاغ عن مشكلة: " Foreground="#A6ADC8"/>
                <Hyperlink NavigateUri="mailto:eslamae420@gmail.com?subject=المؤذن - إبلاغ عن مشكلة"
                           RequestNavigate="Email_RequestNavigate"
                           Foreground="#89B4FA">eslamae420@gmail.com</Hyperlink>
            </TextBlock>
        </StackPanel>
    </ScrollViewer>
</Window>