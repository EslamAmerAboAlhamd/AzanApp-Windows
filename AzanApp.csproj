<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows10.0.17763.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <ApplicationIcon>app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Adhan" Version="*" />
    <PackageReference Include="NAudio" Version="3.3.0" />
    <PackageReference Include="Microsoft.Toolkit.Uwp.Notifications" Version="7.1.3" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Images\**" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Sounds\**" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="azan.mp3" CopyToOutputDirectory="PreserveNewest" Condition="Exists('azan.mp3')" />
    <Resource Include="app.ico" />
    <Resource Include="Fonts\*.ttf" />
  </ItemGroup>

</Project>