<Window x:Class="AzanApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="المؤذن" Height="600" Width="1024"
        Icon="app.ico"
        FontFamily="pack://application:,,,/Fonts/#Cairo"
        WindowStartupLocation="CenterScreen">

    <Grid x:Name="MainGrid">
        <!-- صورة الخلفية -->
        <Image x:Name="ImgBackground" Stretch="UniformToFill"/>

        <!-- طبقة تعتيم خفيفة -->
        <Rectangle Fill="#20000000"/>

        <!-- المحتوى الرئيسي -->
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock x:Name="TxtHeader" Text="آخر صلاة" Foreground="#E0E0E0" FontSize="26" HorizontalAlignment="Center" Margin="0,0,0,10"/>

            <TextBlock x:Name="TxtPrayerName" Text="الظهر" Foreground="#FFFFFF" FontSize="72" FontWeight="Bold" HorizontalAlignment="Center">
                <TextBlock.Effect>
                    <DropShadowEffect BlurRadius="10" Color="Black" ShadowDepth="3"/>
                </TextBlock.Effect>
            </TextBlock>

            <TextBlock x:Name="TxtPrayerTime" Text="11:30 AM" Foreground="#F0F0F0" FontSize="36" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,15,0,0">
                <TextBlock.Effect>
                    <DropShadowEffect BlurRadius="8" Color="Black" ShadowDepth="2"/>
                </TextBlock.Effect>
            </TextBlock>

            <!-- الوقت المتبقي للصلاة القادمة -->
            <Border CornerRadius="14" Background="#66000000" Padding="30,12" Margin="0,30,0,0" HorizontalAlignment="Center">
                <StackPanel>
                    <TextBlock x:Name="TxtRemainingLabel" Text="الوقت المتبقي لصلاة العصر" Foreground="#E0E0E0" FontSize="18" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="TxtRemaining" Text="00:00:00" Foreground="White" FontSize="44" FontWeight="Bold"
                               FlowDirection="LeftToRight" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- التاريخ الهجري أعلى الشاشة -->
        <TextBlock x:Name="TxtHijriDate" Foreground="#F0F0F0" FontSize="20" FontWeight="SemiBold"
                   HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,28,0,0" IsHitTestVisible="False">
            <TextBlock.Effect>
                <DropShadowEffect BlurRadius="8" Color="Black" ShadowDepth="2"/>
            </TextBlock.Effect>
        </TextBlock>

        <!-- مناطق التنقل (يسار / يمين) -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Rectangle Grid.Column="0" Fill="Transparent" Cursor="Hand" MouseDown="LeftZone_MouseDown"/>
            <Rectangle Grid.Column="1" Fill="Transparent" Cursor="Hand" MouseDown="RightZone_MouseDown"/>
        </Grid>

        <!-- زر الإعدادات (يسار) -->
        <Button Width="40" Height="40" HorizontalAlignment="Left" VerticalAlignment="Top"
                Margin="20" Click="BtnSettings_Click" Background="Transparent" BorderThickness="0" Cursor="Hand"
                ToolTip="الإعدادات">
            <TextBlock Text="⚙️" FontFamily="Segoe UI Emoji" FontSize="26" Foreground="White"/>
        </Button>

        <!-- زر التقويم الهجري (يمين) -->
        <Button Width="40" Height="40" HorizontalAlignment="Right" VerticalAlignment="Top"
                Margin="20" Click="BtnCalendar_Click" Background="Transparent" BorderThickness="0" Cursor="Hand"
                ToolTip="التقويم الهجري">
            <TextBlock Text="📅" FontFamily="Segoe UI Emoji" FontSize="26" Foreground="White"/>
        </Button>

        <!-- حقوق الطبع + التواصل -->
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,10">
            <TextBlock Text="Copyright Eslam amer © 2026-2027 All rights reserved."
                       Foreground="#80FFFFFF" FontSize="11" HorizontalAlignment="Center"
                       IsHitTestVisible="False"/>
            <TextBlock HorizontalAlignment="Center" FontSize="11" Margin="0,3,0,0">
                <Run Text="للتواصل والإبلاغ عن مشكلة: " Foreground="#80FFFFFF"/>
                <Hyperlink NavigateUri="mailto:eslamae420@gmail.com?subject=المؤذن - تواصل"
                           RequestNavigate="Email_RequestNavigate"
                           Foreground="#B0FFFFFF">eslamae420@gmail.com</Hyperlink>
            </TextBlock>
        </StackPanel>
    </Grid>
</Window>